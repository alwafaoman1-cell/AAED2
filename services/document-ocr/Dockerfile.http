FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-ara tesseract-ocr-eng libgomp1 libgl1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY ocr_core.py worker.py http_worker.py ./
RUN useradd --create-home --uid 10001 worker
USER worker
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/home/worker PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True PORT=8080
# Bake the same English mobile models; no private request downloads a model.
RUN python -c "from ocr_core import PaddleEnglishProvider; PaddleEnglishProvider()"
EXPOSE 8080
ENTRYPOINT ["python", "http_worker.py"]
